{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "contact-vendas-online",
  "main": "worker/cloudflare.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/"]
  },
  "observability": {
    "enabled": true
  }
}
