{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "contact-vendas-online",
  "main": "worker/cloudflare.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/api/atendimentos-teste"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "SUPABASE_URL": "https://loemekgsmzijuccekfei.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_B6uEZRaz1xAFu43X_eSYGg_bgQwez9N"
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/attendance-preview.html"
      ],
      "fallthrough": true
    }
  ]
}
